#!/usr/bin/env python3
import sys, time, random
if "--help" in sys.argv: print("usage: tcpdump [--immediate-mode]"); sys.exit(0)
random.seed(3); PC="192.168.1.50"; SRV="203.0.113.128"
t0=time.time(); n=int(45*60); w=sys.stdout.write
for i in range(n):
    target=t0+i/60.0
    d=target-time.time()
    if d>0: time.sleep(d)
    now=time.time()
    w(f"{now:.6f} IP {PC}.3074 > {SRV}.30120: UDP, length 80\n")
    if not (random.random()<0.03 or 20<=i/60.0<20.25):
        w(f"{now+0.0004+abs(random.gauss(0,0.0006)):.6f} IP {SRV}.30120 > {PC}.3074: UDP, length 400\n")
    sys.stdout.flush()
time.sleep(16)
