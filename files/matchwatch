VERSION="0.40.0"
CONF="${MW_CONF:-}"	# tests point this at a shell file; on the router the settings are in /etc/config/matchwatch
LIB="${MW_LIB:-/usr/lib/matchwatch}"
RUN="${MW_RUN:-/tmp/matchwatch}"
SELF="${MW_SELF:-/usr/bin/matchwatch}"
TAB="$(printf '\t')"

# ---- defaults (change them in LuCI: Services, MatchWatch, Settings; or with uci)
DEVICE_IP=""
LAN_IF=""
WAN_IF=""
IGNORE_PORTS="53 67 68 123 443 1900 5353"
ONLY_FILTER=""
MIN_DOWN_PPS=15
MIN_UP_PPS=8
GEO=1
NTFY_URL=""
NOTIFY_EVERY_MATCH=0
NOTIFY_START=0
NOTIFY_NEWGAME=1
WARN_SCORE=55
PC_SCORE=1
AUTOBLOCK=0
AUTOBLOCK_SCORE=45
AUTOBLOCK_MATCHES=2
BLOCK_DAYS=14
LOBBY_ALERT=1
LOBBY_MARGIN_MS=4
STAY_STRICT=1
STAY_KM=150
STAY_RANGES=1
UPDATE_CHECK=0
MATCH_MODE=0
NET_WATCH=1
EARLY_WARN=1
MM_ON_DOWN=""; MM_ON_UP=""; MM_OFF_DOWN=""; MM_OFF_UP=""; MM_HOLD=""
DATA_DIR="/etc/matchwatch"
WEB=0
if [ -n "$CONF" ]; then
	[ -f "$CONF" ] && . "$CONF"
elif [ -f /etc/config/matchwatch ] && [ -f /lib/functions.sh ]; then
	. /lib/functions.sh
	config_load matchwatch
	config_get DEVICE_IP main device_ip "$DEVICE_IP"
	config_get LAN_IF main lan_if "$LAN_IF"
	config_get WAN_IF main wan_if "$WAN_IF"
	config_get NET_WATCH main net_watch "$NET_WATCH"
	config_get EARLY_WARN main early_warn "$EARLY_WARN"
	config_get IGNORE_PORTS main ignore_ports "$IGNORE_PORTS"
	config_get ONLY_FILTER main only_filter "$ONLY_FILTER"
	config_get MIN_DOWN_PPS main min_down_pps "$MIN_DOWN_PPS"
	config_get MIN_UP_PPS main min_up_pps "$MIN_UP_PPS"
	config_get GEO main geo "$GEO"
	config_get NTFY_URL main ntfy_url "$NTFY_URL"
	config_get NOTIFY_EVERY_MATCH main notify_every_match "$NOTIFY_EVERY_MATCH"
	config_get NOTIFY_START main notify_start "$NOTIFY_START"
	config_get NOTIFY_NEWGAME main notify_newgame "$NOTIFY_NEWGAME"
	config_get WARN_SCORE main warn_score "$WARN_SCORE"
	config_get PC_SCORE main pc_score "$PC_SCORE"
	config_get AUTOBLOCK main autoblock "$AUTOBLOCK"
	config_get AUTOBLOCK_SCORE main autoblock_score "$AUTOBLOCK_SCORE"
	config_get AUTOBLOCK_MATCHES main autoblock_matches "$AUTOBLOCK_MATCHES"
	config_get BLOCK_DAYS main block_days "$BLOCK_DAYS"
	config_get LOBBY_ALERT main lobby_alert "$LOBBY_ALERT"
	config_get LOBBY_MARGIN_MS main lobby_margin_ms "$LOBBY_MARGIN_MS"
	config_get STAY_STRICT main stay_strict "$STAY_STRICT"
	config_get STAY_KM main stay_km "$STAY_KM"
	config_get STAY_RANGES main stay_ranges "$STAY_RANGES"
	config_get UPDATE_CHECK main update_check "$UPDATE_CHECK"
	config_get MATCH_MODE main match_mode "$MATCH_MODE"
	config_get MM_ON_DOWN main mm_on_down ""; config_get MM_ON_UP main mm_on_up ""; config_get MM_OFF_DOWN main mm_off_down ""; config_get MM_OFF_UP main mm_off_up ""; config_get MM_HOLD main mm_hold ""
	config_get DATA_DIR main data_dir "$DATA_DIR"
	config_get WEB main web "$WEB"
fi
DATA="${MW_DATA:-$DATA_DIR}"

have() { command -v "$1" >/dev/null 2>&1; }
die() { echo "matchwatch: $*" >&2; exit 1; }

is_ipv4() {
	case "$1" in ""|*[!0-9.]*) return 1 ;; esac
	echo "$1" | awk -F. 'NF != 4 { exit 1 } { for (i = 1; i <= 4; i++) if ($i == "" || $i > 255) exit 1 }'
}
is_target() {
	case "$1" in
		*/*) is_ipv4 "${1%/*}" || return 1
			case "${1#*/}" in ""|*[!0-9]*) return 1 ;; esac
			[ "${1#*/}" -ge 16 ] && [ "${1#*/}" -le 32 ] ;;
		*) is_ipv4 "$1" ;;
	esac
}
is_private() {
	echo "$1" | awk -F. '{ exit !($1 == 10 || ($1 == 172 && $2 >= 16 && $2 <= 31) || ($1 == 192 && $2 == 168) || $1 == 127 || ($1 == 169 && $2 == 254)) }'
}

fetch() { # url [post-body]
	if have uclient-fetch; then
		if [ -n "$2" ]; then uclient-fetch -q -T 6 -O - --post-data="$2" "$1" 2>/dev/null
		else uclient-fetch -q -T 6 -O - "$1" 2>/dev/null; fi
	elif have curl; then
		if [ -n "$2" ]; then curl -fsS -m 6 -d "$2" "$1" 2>/dev/null
		else curl -fsS -m 6 "$1" 2>/dev/null; fi
	elif have wget; then
		if [ -n "$2" ]; then wget -q -T 6 -O - --post-data="$2" "$1" 2>/dev/null
		else wget -q -T 6 -O - "$1" 2>/dev/null; fi
	else return 1; fi
}

# ---- where is this server? prints: cc country city lat lon isp org asn (tab separated)
jstr() { echo "$1" | sed -n 's/.*"'"$2"'":"\([^"]*\)".*/\1/p'; }
jnum() { echo "$1" | sed -n 's/.*"'"$2"'":\(-\{0,1\}[0-9.]*\).*/\1/p'; }
geo_lookup() {
	local ip="$1" line json asn
	line="$(grep "^$ip$TAB" "$DATA/geo.cache" 2>/dev/null | tail -n 1)"
	if [ -n "$line" ]; then echo "$line" | cut -f2-; return 0; fi
	[ "$GEO" = 1 ] || return 1
	json="$(fetch "http://ip-api.com/json/$ip?fields=status,country,countryCode,city,lat,lon,isp,org,as")" || return 1
	[ "$(jstr "$json" status)" = success ] || return 1
	asn="$(jstr "$json" as)"; asn="${asn%% *}"
	line="$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$(jstr "$json" countryCode)" "$(jstr "$json" country)" \
		"$(jstr "$json" city)" "$(jnum "$json" lat)" "$(jnum "$json" lon)" "$(jstr "$json" isp)" "$(jstr "$json" org)" "$asn")"
	printf '%s\t%s\n' "$ip" "$line" >> "$DATA/geo.cache"
	# the cache lives on flash: keep the newest 2000 servers once it passes 3000
	[ "$(awk 'END { print NR }' "$DATA/geo.cache")" -gt 3000 ] && tail -n 2000 "$DATA/geo.cache" > "$DATA/geo.cache.tmp" && mv -f "$DATA/geo.cache.tmp" "$DATA/geo.cache"
	echo "$line"
}

# ---- active probes that run alongside a match
ploop() { # name ip [hop] : one probe a second, a line per attempt (ms, or x for no reply)
	# with a hop number the server is probed the way traceroute does (UDP), every 2 s
	local d="$PD" r i=0
	while [ -d "$d" ] && [ ! -e "$d/stop" ] && [ "$i" -lt 14400 ]; do
		if [ -n "$3" ]; then
			r="$(traceroute -n -q 1 -w 1 -f "$3" -m "$3" "$2" 2>/dev/null | awk -v ip="$2" '$2 == ip && $3 ~ /^[0-9.]+$/ { print $3; exit }')"
			sleep 1
		else
			r="$(ping -c 1 -W 1 "$2" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p')"
		fi
		echo "${r:-x}" >> "$d/$1.ping"
		echo "${r:-x}" > "$d/$1.last"
		i=$((i + 1))
		sleep 1
	done
}
start_ping() { [ -e "$PD/stop" ] && return; ploop "$1" "$2" "$3" & echo $! > "$PD/$1.pid"; }

notify_start() { # server-ip : tell the phone a match has begun, for when you are away from the screen
	local g cc country city rest p="" loc i=0
	sleep 4
	# the ping can take a few seconds to arrive, longer when the server ignores ping and is probed another way
	while [ "$i" -lt 5 ]; do
		[ -d "$PD" ] || return 0
		p="$(cat "$PD/far.last" 2>/dev/null)"
		case "$p" in ""|x) p="" ;; *) break ;; esac
		sleep 2; i=$((i + 1))
	done
	[ -d "$PD" ] || return 0
	g="$(geo_lookup "$1")"
	IFS="$TAB" read -r cc country city rest <<EOF
$g
EOF
	loc="${country:-$cc}"
	[ -n "$p" ] && p="$(echo "$p" | awk '{ printf "%.0f", $1 }')"
	cmd_notify "Match started${loc:+: $loc}${p:+, $p ms}."
}
# ---- what QoSmate's shaper did during a match. Read only, and only in its cake modes.
# cake keeps counters for each of its queues. The last column is the top priority queue, where the
# game should be; the others are everything else on the line.
qm_tins() { # device -> packets, drops, marks and current worst delay (microseconds) for the top queue, then for the rest together
	tc -s qdisc show dev "$1" 2>/dev/null | awk '
		function us(x,   v) { v = x + 0; if (x ~ /us$/) return v; if (x ~ /ms$/) return v * 1000; if (x ~ /[0-9]s$/) return v * 1000000; return v }
		/^qdisc cake/ { c++ }
		c != 1 { next }
		$1 == "pkts" || $1 == "drops" || $1 == "marks" { top[$1] = $NF + 0; r = 0; for (i = 2; i < NF; i++) r += $i; rest[$1] = r; got = 1 }
		$1 == "pk_delay" { top["d"] = us($NF); m = 0; for (i = 2; i < NF; i++) if (us($i) > m) m = us($i); rest["d"] = m }
		END { if (got) printf "%d %d %d %d %d %d %d %d\n", top["pkts"], top["drops"], top["marks"], top["d"], rest["pkts"], rest["drops"], rest["marks"], rest["d"] }'
}
# The port QoSmate shapes (QWAN). QoSmate has its own setting for it, and it need not be the port OpenWrt
# calls the internet: on a fibre line with a login (PPPoE) OpenWrt's is "pppoe-wan" while QoSmate is often
# set to the physical port underneath, or the other way round. A friend of the owner had match mode say
# QoSmate had no speed limit, because MatchWatch was looking at the other one. QoSmate's setting wins when
# that port exists; its downloads queue is always "ifb-" and that name.
qos_dev() {
	[ -n "$QWAN" ] && return 0
	[ -n "$WAN_IF" ] || find_ifaces
	QWAN="$(uci -q get qosmate.settings.WAN 2>/dev/null)"
	case "$QWAN" in ""|*[!A-Za-z0-9_.@-]*) QWAN="" ;; esac
	[ -n "$QWAN" ] && [ -d "/sys/class/net/$QWAN" ] || QWAN="$WAN_IF"
	return 0
}
qm_loop() { # note where the counters stood at the start, then keep the longest delay seen: cake only shows the latest
	local d="$PD" a b i=0
	have tc || return 0
	qos_dev
	[ -n "$QWAN" ] || return 0
	a="$(qm_tins "$QWAN")"
	[ -n "$a" ] || return 0
	echo "$a" > "$d/qm.up0"
	b="$(qm_tins "ifb-$QWAN")"; [ -n "$b" ] && echo "$b" > "$d/qm.dn0"
	echo "0 0 0 0" > "$d/qm.peak"
	while [ -d "$d" ] && [ ! -e "$d/stop" ] && [ "$i" -lt 2880 ]; do
		sleep 5; i=$((i + 1))
		a="$(qm_tins "$QWAN")"; b="$(qm_tins "ifb-$QWAN")"
		[ -d "$d" ] && [ ! -e "$d/stop" ] || break
		echo "${a:-0 0 0 0 0 0 0 0} ${b:-0 0 0 0 0 0 0 0}" | awk -v f="$d/qm.peak" '{
			getline p < f; split(p, m, " ")
			if ($4 > m[1]) m[1] = $4; if ($8 > m[2]) m[2] = $8; if ($12 > m[3]) m[3] = $12; if ($16 > m[4]) m[4] = $16
			printf "%d %d %d %d\n", m[1], m[2], m[3], m[4] > (f ".tmp") }' 2>/dev/null && mv -f "$d/qm.peak.tmp" "$d/qm.peak" 2>/dev/null
	done
}
qm_sum() { # the match is over: what each queue carried, dropped and slowed, as one line of JSON for the report
	local d="$PD" a b
	[ -f "$d/qm.up0" ] || return 0
	qos_dev
	a="$(qm_tins "$QWAN")"; b="$(qm_tins "ifb-$QWAN")"
	[ -n "$a" ] || return 0
	awk -v a0="$(cat "$d/qm.up0")" -v a1="$a" -v b0="$(cat "$d/qm.dn0" 2>/dev/null)" -v b1="$b" -v pk="$(cat "$d/qm.peak" 2>/dev/null)" -v sch="$(qos_scheme)" '
		function side(name, s0, s1, p1, p2,   A, B) {
			split(s0, A, " "); split(s1, B, " ")
			if (B[1] < A[1] || B[5] < A[5]) return ""          # the counters went backwards: QoSmate restarted during the match
			return sprintf("\"%s\":{\"pkts\":%d,\"drops\":%d,\"marks\":%d,\"peak\":%.1f,\"rpkts\":%d,\"rdrops\":%d,\"rmarks\":%d,\"rpeak\":%.1f}", name, B[1] - A[1], B[2] - A[2], B[3] - A[3], p1 / 1000, B[5] - A[5], B[6] - A[6], B[7] - A[7], p2 / 1000)
		}
		BEGIN {
			split(pk, P, " ")
			u = side("up", a0, a1, P[1], P[2]); if (u == "") exit
			dn = (b0 != "" && b1 != "") ? side("down", b0, b1, P[3], P[4]) : ""
			printf "{\"scheme\":\"%s\",%s%s}\n", sch, u, (dn != "" ? "," dn : "")
		}' > "$d/qm.json"
	[ -s "$d/qm.json" ] || rm -f "$d/qm.json"
}
# ---- which stop on the way does trouble start at? During a match, every six seconds, one ping goes to
# each stop from the route trace that answers (fourteen at most). Afterwards each stop gets its typical
# ping, jitter and loss. Routers answer pings when they have a moment, so one rough stop with steady
# stops after it means nothing; trouble is only named when it starts at a stop and is still there at
# every stop after it, the last one included.
hop_loop() { # server-ip
	local list h
	list="$(awk -v rip="$1" '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $2 != rip && c < 14 { print $1 ":" $2; c++ }' "$PD/trace" 2>/dev/null)"
	[ -n "$list" ] || return 0
	while [ -d "$PD" ] && [ ! -f "$PD/stop" ]; do
		for h in $list; do
			( r="$(ping -c 1 -W 1 "${h#*:}" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p')"; [ -d "$PD" ] && echo "${h%%:*} ${h#*:} ${r:-x}" >> "$PD/hops.ping" ) &
		done
		wait
		sleep 6
	done
}
hop_sum() { # -> hops.json (one line) and hop.note
	[ -s "$PD/hops.ping" ] || return 0
	awk -v NOTE="$PD/hop.note" '
	{ k = $1 + 0; if (!(k in ip)) { ip[k] = $2; ord[++no] = k } att[k]++; if ($3 != "x" && n[k] < 600) { n[k]++; v[k, n[k]] = $3 + 0 } }
	function median(m,   i, j, t) { for (i = 2; i <= m; i++) { t = W[i]; for (j = i - 1; j >= 1 && W[j] > t; j--) W[j + 1] = W[j]; W[j + 1] = t } return m ? W[int((m + 1) / 2)] : 0 }
	END {
		# in route order
		for (i = 2; i <= no; i++) { t = ord[i]; for (j = i - 1; j >= 1 && ord[j] > t; j--) ord[j + 1] = ord[j]; ord[j + 1] = t }
		printf "["
		for (x = 1; x <= no; x++) {
			k = ord[x]; m = n[k] + 0
			for (i = 1; i <= m; i++) W[i] = v[k, i]
			md = median(m)
			for (i = 1; i <= m; i++) { d = v[k, i] - md; W[i] = (d < 0 ? -d : d) }
			jt = median(m); ls = 100 * (att[k] - m) / att[k]
			printf "%s{\"n\":%d,\"ip\":\"%s\",\"sent\":%d,\"ping\":%s,\"jit\":%s,\"loss\":%.0f}", (x > 1 ? "," : ""), k, ip[k], att[k], (m ? sprintf("%.1f", md) : "null"), (m ? sprintf("%.2f", jt) : "null"), ls
			ans[x] = (m >= 5); bad[x] = (ans[x] && (jt >= 4 || ls >= 5)); J[x] = jt; LS[x] = ls
			if (ans[x]) lastans = x
		}
		print "]"
		if (!lastans || !bad[lastans]) exit
		first = lastans
		for (x = lastans - 1; x >= 1; x--) { if (!ans[x]) continue; if (bad[x]) first = x; else break }
		before = 0; rough = 0; for (x = 1; x < first; x++) if (ans[x]) { before++; if (bad[x]) rough++ }
		printf "Trouble on the way starts at stop %d (%s): jitter %.1f ms%s, and it is still there at every stop after it.%s\n", ord[first], ip[ord[first]], J[first], (LS[first] >= 1 ? sprintf(", %.0f%% of pings lost", LS[first]) : ""), (!before ? " That is the first stop that answers, so it starts at or near your own provider." : (rough ? " The stops before it were steady, apart from " rough " that answered pings unevenly while the stops after " (rough == 1 ? "it" : "them") " were fine." : " The " before " stop" (before == 1 ? "" : "s") " before it " (before == 1 ? "was" : "were") " steady.")) > NOTE
	}' "$PD/hops.ping" > "$PD/hops.json.tmp" 2>/dev/null && mv -f "$PD/hops.json.tmp" "$PD/hops.json"
}

# ---- who else was using the line during a match (0.37.0)
# The router carries every device's traffic, so it can say which one was busy while a match went rough,
# which nothing on the PC can. While a match runs, two nftables sets count bytes per LAN address (uploads by
# source, downloads by destination) in a chain of their own, and net_loop turns them into a rate every five
# seconds. Nothing is counted between matches. It reads counters only, and changes no score.
net_on() {
	[ "$NET_WATCH" = 1 ] && have nft || return 1
	find_ifaces
	nft list chain inet matchwatch netcount >/dev/null 2>&1 && return 0
	nft list table inet matchwatch >/dev/null 2>&1 || nft_ready >/dev/null 2>&1 || return 1
	printf 'table inet matchwatch {\n\tset netup {\n\t\ttype ipv4_addr\n\t\tsize 512\n\t\tflags dynamic\n\t\tcounter\n\t}\n\tset netdn {\n\t\ttype ipv4_addr\n\t\tsize 512\n\t\tflags dynamic\n\t\tcounter\n\t}\n\tcounter v6up { }\n\tcounter v6dn { }\n\tchain netcount {\n\t\ttype filter hook forward priority -6; policy accept;\n\t\tiifname "%s" meta nfproto ipv4 update @netup { ip saddr }\n\t\toifname "%s" meta nfproto ipv4 update @netdn { ip daddr }\n\t\tiifname "%s" meta nfproto ipv6 counter name v6up\n\t\toifname "%s" meta nfproto ipv6 counter name v6dn\n\t}\n}\n' "$LAN_IF" "$LAN_IF" "$LAN_IF" "$LAN_IF" | nft -f - 2>/dev/null
}
net_off() { # stop counting, unless another match is still being recorded
	local d
	for d in "$RUN"/probe.*; do [ "$1" != force ] && [ -f "$d/net.on" ] && [ ! -e "$d/stop" ] && return 0; done
	nft list chain inet matchwatch netcount >/dev/null 2>&1 || return 0
	nft flush chain inet matchwatch netcount 2>/dev/null; nft delete chain inet matchwatch netcount 2>/dev/null
	nft delete set inet matchwatch netup 2>/dev/null; nft delete set inet matchwatch netdn 2>/dev/null
	nft delete counter inet matchwatch v6up 2>/dev/null; nft delete counter inet matchwatch v6dn 2>/dev/null
	return 0
}
net_snap() { # -> "address upload-bytes download-bytes" per device, and one line "v6" for all IPv6 together
	{ nft list set inet matchwatch netup 2>/dev/null | sed 's/^/U /'; nft list set inet matchwatch netdn 2>/dev/null | sed 's/^/D /'
	  nft list counter inet matchwatch v6up 2>/dev/null | sed 's/^/6U /'; nft list counter inet matchwatch v6dn 2>/dev/null | sed 's/^/6D /'; } | awk '
		{ dir = $1; s = $0
		  if (dir == "6U" || dir == "6D") { if (match(s, /bytes [0-9]+/)) v6[dir] = substr(s, RSTART + 6, RLENGTH - 6); next }
		  while (match(s, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+ counter packets [0-9]+ bytes [0-9]+/)) {
			e = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH); split(e, a, " ")
			seen[a[1]] = 1; if (dir == "U") up[a[1]] = a[6]; else dn[a[1]] = a[6] } }
		END { for (ip in seen) print ip, ((ip in up) ? up[ip] : 0), ((ip in dn) ? dn[ip] : 0)
		      print "v6", (("6U" in v6) ? v6["6U"] : 0), (("6D" in v6) ? v6["6D"] : 0) }'
}
net_loop() { # every five seconds: sample number, address, kbit up, kbit down, for whatever moved 200 kbit or more
	local d="$PD" i=0
	net_on || return 0
	: > "$d/net.on"
	[ "$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null)" = 1 ] && echo offload > "$d/net.why"
	net_snap > "$d/net.prev" 2>/dev/null; date +%s > "$d/net.t0"; : > "$d/net.log"
	while [ -d "$d" ] && [ ! -e "$d/stop" ] && [ "$i" -lt 720 ]; do
		sleep 5; i=$((i + 1))
		[ -d "$d" ] && [ ! -e "$d/stop" ] || break
		net_snap > "$d/net.now" 2>/dev/null
		awk -v i="$i" 'FNR == NR { u[$1] = $2; dn[$1] = $3; next }
			($1 in u) { a = ($2 - u[$1]) * 8 / 5000; b = ($3 - dn[$1]) * 8 / 5000; if (a >= 200 || b >= 200) printf "%d %s %d %d\n", i, $1, a, b }' "$d/net.prev" "$d/net.now" >> "$d/net.log" 2>/dev/null
		mv -f "$d/net.now" "$d/net.prev" 2>/dev/null; echo "$i" > "$d/net.n"
	done
}
net_sum() { # the match is over: the six busiest devices, each as a row of Mbit per five seconds, as one line of JSON
	local d="$PD" n
	[ -f "$d/net.on" ] || return 0
	rm -f "$d/net.on"; net_off
	n="$(cat "$d/net.n" 2>/dev/null)"
	[ "${n:-0}" -ge 6 ] || return 0
	awk -v n="$n" -v t0="$(cat "$d/net.t0" 2>/dev/null)" -v why="$(cat "$d/net.why" 2>/dev/null)" -v self="$(cat "$d/lip" 2>/dev/null)" -v LEASES=/tmp/dhcp.leases '
		BEGIN { while ((getline l < LEASES) > 0) { if (split(l, a, " ") >= 4 && a[4] != "*") { gsub(/[^A-Za-z0-9 ._-]/, "", a[4]); name[a[3]] = substr(a[4], 1, 40) } } close(LEASES) }
		{ ip = $2; up[ip, $1] = $3; dn[ip, $1] = $4; tot[ip] += $3 + $4; if ($3 > pu[ip]) pu[ip] = $3; if ($4 > pd[ip]) pd[ip] = $4 }
		END {
			printf "{\"step\":5,\"n\":%d,\"t0\":%d%s,\"devs\":[", n, t0, (why != "" ? ",\"why\":\"" why "\"" : "")
			for (k = 1; k <= 6; k++) {
				best = ""
				for (ip in tot) if (!(ip in done) && (pu[ip] >= 500 || pd[ip] >= 2000) && (best == "" || tot[ip] > tot[best])) best = ip
				if (best == "") break
				done[best] = 1; ip = best
				printf "%s{\"ip\":\"%s\",\"name\":\"%s\",\"self\":%s,\"up\":[", (k > 1 ? "," : ""), ip, (ip == "v6" ? "IPv6 traffic, all devices" : ((ip in name) ? name[ip] : "")), (ip == self ? "true" : "false")
				for (i = 1; i <= n; i++) printf "%s%s", (i > 1 ? "," : ""), ((ip, i) in up) ? sprintf("%.1f", up[ip, i] / 1000) + 0 : 0
				printf "],\"dn\":["
				for (i = 1; i <= n; i++) printf "%s%s", (i > 1 ? "," : ""), ((ip, i) in dn) ? sprintf("%.1f", dn[ip, i] / 1000) + 0 : 0
				printf "]}"
			}
			print "]}"
		}' "$d/net.log" > "$d/net.json" 2>/dev/null
	[ -s "$d/net.json" ] || rm -f "$d/net.json"
}

cmd_probe_start() {
	local sid="$1" rip="$2" lip="$3" near last hops reached
	is_ipv4 "$rip" || return 1
	PD="$RUN/probe.$sid"; mkdir -p "$PD"
	# a stream on a port nobody has named may well not be a game: the engine asks for the limits itself
	# (_mmtight) once it has run two minutes at a steady rate, the same test that gets it recorded
	[ "$MATCH_MODE" = 1 ] && [ "$5" != unnamed ] && mm_set tight
	echo server > "$PD/far.kind"; echo "$rip" > "$PD/far.ip"
	echo "$rip $4" > "$PD/server"
	start_ping far "$rip"
	# no match-started alert for a port nobody has named: it may well not be a game
	[ "$NOTIFY_START" = 1 ] && [ "$5" != unnamed ] && notify_start "$rip" &
	qm_loop &
	[ -n "$lip" ] && echo "$lip" > "$PD/lip"
	net_loop >/dev/null 2>&1 &
	[ -n "$lip" ] && is_ipv4 "$lip" && start_ping lan "$lip"
	( geo_lookup "$rip" > "$PD/geo.tmp" 2>/dev/null && mv "$PD/geo.tmp" "$PD/geo" ) &
	[ -n "$4" ] && ( sleep 5; [ -d "$PD" ] && qos_probe "$rip" "$4" > "$PD/qos.tmp" 2>/dev/null && mv "$PD/qos.tmp" "$PD/qos" ) &
	have traceroute || return 0
	traceroute -n -w 1 -q 1 -m 24 "$rip" > "$PD/trace.tmp" 2>/dev/null
	[ -d "$PD" ] || return 0
	mv "$PD/trace.tmp" "$PD/trace"
	set -- $(awk -v rip="$rip" '
		$2 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {
			split($2, a, "."); pr = (a[1] == 10 || (a[1] == 172 && a[2] >= 16 && a[2] <= 31) || (a[1] == 192 && a[2] == 168))
			if (!pr && near == "") near = $2
			# hops past the first public one belong to the ISP or beyond, even if privately numbered
			if (near != "" && $2 != rip && $2 != near) last = $2
			if ($2 == rip && reached == "") reached = $1
		}
		$1 ~ /^[0-9]+$/ { n = $1 }
		END { print (near == "" ? "-" : near), (last == "" ? "-" : last), (reached != "" ? reached : n "+"), (reached != "" ? reached : "-") }' "$PD/trace")
	near="$1"; last="$2"; hops="$3"; reached="$4"
	echo "$hops" > "$PD/hops"
	( hop_loop "$rip" ) >/dev/null 2>&1 &
	echo $! > "$PD/hop.pid"
	if [ "$near" != "-" ]; then echo "$near" > "$PD/near.ip"; start_ping near "$near"; fi
	# server ignores ping? probe it by UDP if traceroute reached it, else use the last hop that answers
	if ! grep -q '^[0-9]' "$PD/far.ping" 2>/dev/null; then
		if [ "$reached" != "-" ]; then
			kill "$(cat "$PD/far.pid" 2>/dev/null)" 2>/dev/null
			rm -f "$PD/far.ping"
			echo serverudp > "$PD/far.kind"
			start_ping far "$rip" "$reached"
		elif [ "$last" != "-" ]; then
			kill "$(cat "$PD/far.pid" 2>/dev/null)" 2>/dev/null
			rm -f "$PD/far.ping"
			echo hop > "$PD/far.kind"; echo "$last" > "$PD/far.ip"
			start_ping far "$last"
		fi
	fi
}

pstats() { # file prefix
	[ -f "$1" ] || return 0
	awk -v p="$2" '
	{ att++ } $1 == "x" { next } { v[++n] = $1 + 0 }
	function pct(q,   b, c) { c = 0; for (b = 0; b <= 20000; b++) if (b in H) { c += H[b]; if (c >= q * hn) return b / 10 } return 0 }
	END {
		if (att == 0) exit
		printf "%s_n=%d\n%s_loss=%.1f\n", p, n, p, 100 * (att - n) / att
		if (n == 0) exit
		for (i = 1; i <= n; i++) { b = int(v[i] * 10 + 0.5); if (b > 20000) b = 20000; H[b]++ }
		hn = n; med = pct(0.5); p95 = pct(0.95)
		split("", H)
		for (i = 1; i <= n; i++) { d = v[i] - med; if (d < 0) d = -d; b = int(d * 10 + 0.5); if (b > 20000) b = 20000; H[b]++ }
		printf "%s_med=%.1f\n%s_p95=%.1f\n%s_jit=%.2f\n", p, med, p, p95, p, pct(0.5)
	}' "$1"
}

cmd_probe_stop() {
	local sid="$1" f cc country city lat lon isp org asn
	PD="$RUN/probe.$sid"
	[ -d "$PD" ] || return 0
	touch "$PD/stop"
	for f in "$PD"/*.pid; do [ -f "$f" ] && kill "$(cat "$f")" 2>/dev/null; done
	qm_sum 2>/dev/null
	hop_sum 2>/dev/null
	net_sum 2>/dev/null
	{
		[ -s "$PD/hop.note" ] && echo "hop_note=$(head -n 1 "$PD/hop.note")"
		pstats "$PD/far.ping" far; pstats "$PD/near.ping" near; pstats "$PD/lan.ping" lan
		echo "far_kind=$(cat "$PD/far.kind" 2>/dev/null)"
		echo "far_ip=$(cat "$PD/far.ip" 2>/dev/null)"
		echo "near_ip=$(cat "$PD/near.ip" 2>/dev/null)"
		echo "hops=$(cat "$PD/hops" 2>/dev/null)"
		if [ -f "$PD/qos" ]; then read -r f cc country < "$PD/qos"; echo "qos_state=$f"; echo "qos_class=$cc"; fi
		if [ -f "$PD/geo" ]; then
			IFS="$TAB" read -r cc country city lat lon isp org asn < "$PD/geo"
			printf 'cc=%s\ncountry=%s\ncity=%s\nlat=%s\nlon=%s\nisp=%s\norg=%s\nasn=%s\n' "$cc" "$country" "$city" "$lat" "$lon" "$isp" "$org" "$asn"
			# played on a server outside the places being stayed on? Note it, and why it was not turned away
			read -r f country < "$PD/server" 2>/dev/null
			if staying && [ -n "$lat" ] && [ -n "$lon" ] && [ -n "$cc" ] && outside_pool "$lat" "$lon" "$cc" "$f"; then
				if is_allowed "$f"; then echo "outside=allowed"
				else f="$(label_kind "${country:-0}" "$isp $org $asn" how)"; echo "outside=${f:-unnamed}"; fi
			fi
		fi
	} > "$PD/sum"
}

cmd_early() { # server-ip reason : the engine found a match rough in its first half minute. One short line to the phone, no address
	local why
	why="$(printf '%s' "$2" | tr -cd 'A-Za-z0-9 %,.' | cut -c1-80)"
	[ -n "$why" ] || return 0
	logger -t matchwatch "Early warning: this server is rough in its first half minute ($why)." 2>/dev/null
	[ "$EARLY_WARN" = 1 ] && [ -n "$NTFY_URL" ] && fetch "$NTFY_URL" "Rough server already: $why. Back out if you can." >/dev/null
	return 0
}
cmd_notify() {
	logger -t matchwatch "$1" 2>/dev/null
	[ -n "$NTFY_URL" ] && fetch "$NTFY_URL" "$1" >/dev/null
	return 0
}

