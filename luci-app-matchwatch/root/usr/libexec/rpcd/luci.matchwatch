#!/bin/sh
# rpcd backend for luci-app-matchwatch: runs the dashboard's buttons.
# Two methods so LuCI's permissions can tell looking from changing:
#   read   checks, the line test, a route trace, the activity log, making a share file, the version check, and "I felt that"
#   write  updating, and stopping, starting or restarting the service, and anything that blocks, stays, favourites, measures, alerts, renames, clears, imports, or changes QoSmate or the device
# The work itself is done by /usr/bin/matchwatch _action, which validates every argument.

. /usr/share/libubox/jshn.sh

READ="hello mark devices doctor qos log linetest trace shareexport updatecheck nat qosadvice report pbadvice"
WRITE="block unblock blockdc unblockdc stay stayoff stayadd stayrm staysuggest regions qosfix qosunfix setdevice setdeviceall testalert gamename gamedel clearhistory sharecheck shareimport shareundo shareforget shareforgetgs fav unfav forgetmatch forgetserver forgetdc update allow unallow staycircle stayset holdon holdoff matchmodeon matchmodeoff matchmodeset matchgame pingrange pingoff svcstop svcstart svcrestart natfix natunfix natfwd natunfwd"

reply() { # ok(0|1) text
	json_init
	json_add_boolean ok "$1"
	json_add_string out "$2"
	json_dump
}

case "$1" in
	list)
		echo '{"read":{"action":"str","arg":"str"},"write":{"action":"str","arg":"str","days":"str","region":"str","name":"str","data":"str"}}'
		;;
	call)
		read -r input
		json_load "$input" 2>/dev/null || { reply 0 "bad request"; exit 0; }
		json_get_var action action
		json_get_var arg arg
		json_get_var days days
		json_get_var region region
		json_get_var name name
		json_get_var data data

		case "$2" in
			read) allowed="$READ" ;;
			# whoever may change things may also look. The LuCI page keeps its own list of which actions only look,
			# and a browser can hold an old copy of that page: a new looking action then arrives here as "write".
			write) allowed="$WRITE $READ" ;;
			*) reply 0 "unknown method"; exit 0 ;;
		esac
		case "$action" in ""|*[!a-z]*) reply 0 "unknown action"; exit 0 ;; esac
		case " $allowed " in *" $action "*) ;; *) reply 0 "unknown action"; exit 0 ;; esac

		# a share file being checked or imported goes in on standard input
		if out="$(printf '%s
' "$data" | /usr/bin/matchwatch _action "$action" "$arg" "$days" "$region" "$name" 2>&1)"; then
			reply 1 "$out"
		else
			reply 0 "$out"
		fi
		;;
esac
